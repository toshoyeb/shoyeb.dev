---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="That didn't send — Shoyeb Akhtar"
  description="The enquiry form could not be submitted."
  path="/contact-error"
>
  <Nav />
  <main id="main" class="note">
    <div class="container">
      <p class="label">Not sent</p>
      <h1>That didn&rsquo;t go through.</h1>
      <p class="lede">
        Either a field was missing or something broke on my end. Rather than have you fill
        it in again, email me at{" "}
        <a href="mailto:hello@shoyeb.dev" data-copy="hello@shoyeb.dev">hello@shoyeb.dev</a> and I&rsquo;ll pick it up
        from there.
      </p>
      <p class="back"><a href="/#contact">&larr; Back to the form</a></p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .note { padding-block: clamp(4rem, 12vw, 8rem); }
  h1 { margin-block: 1rem 1.25rem; font-size: var(--step-4); }
  .lede { max-width: 52ch; }
  .back { margin-top: 2rem; }
</style>
