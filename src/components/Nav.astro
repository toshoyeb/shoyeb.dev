---
import ThemeToggle from "./ThemeToggle.astro";

/* The first four scroll the page you are on; Writing loads a different page.
   It is set apart rather than styled as a fifth jump link. */
const sections = [
  { href: "/#about", label: "About" },
  { href: "/#services", label: "What I do" },
  { href: "/#shipped", label: "Work" },
  { href: "/#skills", label: "Skills" },
];
---

<header class="nav">
  <div class="container-wide inner">
    <a class="wordmark" href="/">
      <span class="mark" aria-hidden="true"></span>
      shoyeb<span class="tld">.dev</span>
    </a>

    <nav aria-label="Sections">
      <ul>
        {sections.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li class="elsewhere"><a href="/writing">Writing</a></li>
      </ul>
    </nav>

    <div class="actions">
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        Available for work
      </p>
      <ThemeToggle />
      <a class="cta" href="/#contact">Let&rsquo;s talk</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    /* 86% let content read straight through the bar on mobile, where the page
       scrolls directly beneath it — enough opacity to stay a surface, not a veil */
    background: color-mix(in srgb, var(--ground) 94%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    min-height: 4.5rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }
  .tld { color: var(--muted); }

  .mark {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 2px;
    background: var(--accent-vivid);
    transform: rotate(45deg);
    transition: transform 220ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .wordmark:hover .mark { transform: rotate(135deg); }

  nav ul {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* a rule, not a different shape: this one leaves the page */
  .elsewhere {
    padding-left: 2rem;
    border-left: 1px solid var(--rule);
  }
  .elsewhere a { color: var(--ink); }

  nav a {
    position: relative;
    color: var(--muted);
    text-decoration: none;
    font-size: var(--step-0);
    padding-block: 0.35rem;
  }
  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1.5px;
    background: var(--accent-vivid);
    transition: right 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  nav a:hover { color: var(--ink); }
  nav a:hover::after { right: 0; }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    white-space: nowrap;
  }

  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent-vivid);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-vivid) 22%, transparent);
  }

  .cta {
    padding: 0.55rem 1.15rem;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--on-accent);
    text-decoration: none;
    font-size: var(--step-0);
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 180ms ease, border-color 180ms ease;
  }
  .cta:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--on-accent);
  }

  /* no hamburger — links and status fold away, the toggle and CTA stay */
  @media (max-width: 62rem) {
    nav { display: none; }
    .inner { gap: 1rem; }
  }
  @media (max-width: 34rem) {
    .status { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark,
    nav a::after {
      transition: none;
    }
  }
</style>
