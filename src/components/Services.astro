---
/* Deliberately written as problems the buyer recognises, not as framework names.
   The stack lives further down the page. */
const services = [
  {
    title: "Take over an existing app",
    body:
      "The app exists, but whoever built it has moved on, or it has stalled. I learn the codebase, tell you honestly what state it is in, and take over shipping it.",
  },
  {
    title: "Fix crashes and performance",
    body:
      "Users are hitting crashes you cannot reproduce, or the app is slow on the phones people actually own. I work from real crash and trace data rather than guesses.",
  },
  {
    title: "Get it into the stores",
    body:
      "Signing, provisioning, TestFlight, App Store Connect, Play Console, review. The part that stalls launches and has nothing to do with your product.",
  },
  {
    title: "Build features",
    body:
      "New screens and flows inside an app that already has users, wired to your backend, without leaving a mess for whoever comes next.",
  },
  {
    title: "Keep it running",
    body:
      "Ongoing engineering ownership: releases, SDK upgrades, store policy changes, and the crashes that show up when the OS updates. Monthly, not per-ticket.",
  },
  {
    title: "Build the website too",
    body:
      "Marketing sites, landing pages and internal tools in React and Next.js, built to load fast rather than to win awards. Useful when the app and the site need to say the same thing.",
    refs: [
      { label: "range.now", href: "https://www.range.now/" },
      { label: "sitelead.range.now", href: "https://sitelead.range.now/" },
    ],
  },
];
---

<section id="services" class="services">
  <div class="container">
    <p class="label">What I do</p>
    <h2>Six things people hire me for</h2>

    <ul>
      {services.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <div>
            <p>{s.body}</p>
            {s.refs && (
              <p class="refs">
                Live:{" "}
                {s.refs.map((r, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true"> &middot; </span>}
                    <a href={r.href} rel="noopener">{r.label}</a>
                  </>
                ))}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    padding-block: var(--section-gap);
    border-bottom: 1px solid var(--rule);
  }

  h2 { margin-block: 0.75rem 3rem; }

  ul {
    display: grid;
    gap: 0;
  }

  li {
    display: grid;
    gap: 0.5rem 3rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--rule);
  }
  li:last-child { border-bottom: 1px solid var(--rule); }

  /* title in a fixed left column, prose in a readable measure beside it */
  @media (min-width: 48rem) {
    li {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      align-items: baseline;
    }
  }

  h3 { color: var(--ink); }
  p { color: var(--muted); max-width: 58ch; }

  .refs {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
